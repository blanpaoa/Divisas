# Copiar este archivo a ".env" y completar antes de arrancar el servidor

# Puerto donde corre la API
PORT=4000

# Secreto para firmar los tokens de sesion (JWT). Usar un valor largo y aleatorio en produccion.
JWT_SECRET=cambiar_este_valor_por_algo_seguro_y_largo

# Horas de duracion de la sesion
JWT_EXPIRES_IN=12h

# Ruta del archivo de base de datos SQLite
DB_PATH=./data/casa_cambio.db

# Usuario administrador inicial (se crea solo la primera vez que se corre el servidor)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_esta_clave
